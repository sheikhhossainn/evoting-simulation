PORT=3000
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ElGamal keys (run: npx ts-node src/scripts/setup-keys.ts)
NID_HASH_SALT=
ELGAMAL_P=
ELGAMAL_G=
ELGAMAL_PUBLIC_KEY=
ELGAMAL_PRIVATE_KEY=

# Shamir's Secret Sharing (run: npx ts-node src/scripts/setup-shamir.ts)
# SHAMIR_SHARE_1..4 are appended automatically for local testing.

# Server-side secret for the salted nullifier: SHA-256(nid + election_id +
# NULLIFIER_SECRET), computed only in backend/src/crypto/identity.ts. Must
# never reach the client — a nullifier a browser could recompute is no secret.
NULLIFIER_SECRET=

# Salt used to hash keyholder passphrases (see src/config/keyholders.ts).
# Demo keyholders (KH-001/share001 .. KH-004/share004) work without any
# further config. For a real deployment, generate real secrets and set
# KEYHOLDER_PASSPHRASE_HASH_1..4 = sha256(passphrase + this salt) instead.
KEYHOLDER_PASSPHRASE_SALT=

# Shared secret required (via `x-admin-secret` header) for sensitive admin
# routes (POST /anchor/batch, POST /keyshares/tally) until real session-based
# admin auth is implemented.
ADMIN_SECRET=

# Ethereum Sepolia anchoring (see blockchain/ package — deploy MerkleRootStorage
# there first, then fill these in). Leave blank to disable anchoring;
# /anchor/batch will respond 503 until configured. AMOY_RPC_URL is a legacy
# variable name that now holds the Sepolia RPC URL.
AMOY_RPC_URL=
MERKLE_CONTRACT_ADDRESS=
ANCHOR_PRIVATE_KEY=

# ── P1 hardening ──
# Demo-only tamper routes (POST /anchor/tamper/{root,ballot,delete-vote} and
# POST /anchor/restore/root). One of them is not hypothetical: delete-vote
# genuinely deletes a vote row via fn_admin_delete_vote. Unless this is exactly
# "1" those four routes answer 404 — absent, not merely forbidden. Never set it
# in production.
ENABLE_TAMPER_DEMO=

# CAPTCHA gate for POST /voter/register (threat T10). Leave blank to disable:
# the gate is then inert and index.ts logs a startup warning, so it can never be
# mistaken for active protection. When set, a valid provider token is required —
# `x-captcha-token` header or `captcha_token` body field — and verified against
# CAPTCHA_VERIFY_URL (default: Cloudflare Turnstile siteverify).
CAPTCHA_SECRET=
CAPTCHA_VERIFY_URL=
